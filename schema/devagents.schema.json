{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyperformant/devagents/schema/devagents.schema.json",
  "title": "devagents central config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "$ref": "#/$defs/settings"
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/jobName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/job"
      }
    }
  },
  "$defs": {
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\[\\]-]*$"
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "timeoutMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360
    },
    "jobName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "schedule",
          "pr",
          "manual"
        ]
      }
    },
    "schedule": {
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "with": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/model"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "fallback_model": {
          "$ref": "#/$defs/model"
        },
        "max_turns": {
          "$ref": "#/$defs/maxTurns"
        },
        "timeout_minutes": {
          "$ref": "#/$defs/timeoutMinutes"
        },
        "allowed_tools": {
          "$ref": "#/$defs/allowedTools"
        }
      },
      "required": [
        "allowed_tools"
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggers",
        "prompt"
      ],
      "properties": {
        "triggers": {
          "$ref": "#/$defs/triggers"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "pre_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^scripts/[A-Za-z0-9._/-]+$"
          }
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "fallback_model": {
          "$ref": "#/$defs/model"
        },
        "max_turns": {
          "$ref": "#/$defs/maxTurns"
        },
        "timeout_minutes": {
          "$ref": "#/$defs/timeoutMinutes"
        },
        "with": {
          "$ref": "#/$defs/with"
        },
        "allowed_tools": {
          "$ref": "#/$defs/allowedTools"
        }
      },
      "if": {
        "properties": {
          "triggers": {
            "contains": {
              "const": "schedule"
            }
          }
        },
        "required": [
          "triggers"
        ]
      },
      "then": {
        "required": [
          "schedule"
        ]
      }
    },
    "override": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "$ref": "#/$defs/triggers"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "fallback_model": {
          "$ref": "#/$defs/model"
        },
        "max_turns": {
          "$ref": "#/$defs/maxTurns"
        },
        "timeout_minutes": {
          "$ref": "#/$defs/timeoutMinutes"
        },
        "with": {
          "$ref": "#/$defs/with"
        }
      }
    },
    "allowedTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(Read|Glob|Grep|Edit|Write|Bash\\([a-z][a-z0-9_-]*( [a-z][a-z0-9_-]+)* \\*\\))$"
      }
    }
  }
}
